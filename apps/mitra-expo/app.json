{
  "expo": {
    "name": "Mikala Mitra",
    "slug": "mikala-mitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mikala-mitra",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mikalaglobalmedika.mitra"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      },
      "package": "com.mikalaglobalmedika.mitra",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Mikala Mitra mengakses galeri untuk memilih foto profil.",
          "cameraPermission": "Izinkan Mikala Mitra memakai kamera untuk mengambil foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c3aed",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.mikalaglobalmedika.com/api",
      "router": {},
      "eas": {
        "projectId": "394405c3-ddab-43a0-a018-4fc13cee075f"
      }
    },
    "owner": "aditdeep"
  }
}
